# Backend Settings
PROJECT_NAME="Egyptian ASR Dataset Builder"
# DATABASE_URL="sqlite:///./sql_app.db"
# Docker: host is the `mysql` service; the password must equal MYSQL_PASSWORD below
# (URL-encode it if it contains special characters such as @ : / #).
DATABASE_URL="mysql+pymysql://asr_user:CHANGE_ME@mysql:3306/asr_dataset"
REDIS_URL="redis://redis:6379/0"
DATA_PATH="./data"

# Audio Processing Settings
DEFAULT_SAMPLE_RATE=16000
DEFAULT_SILENCE_THRESH=-40
DEFAULT_MIN_SILENCE_LEN=700
DEFAULT_MIN_CHUNK_LEN=1000
DEFAULT_MAX_CHUNK_LEN=20000

# HuggingFace Settings
HF_TOKEN=""

# Gemini Settings
GEMINI_API_KEY=""
# Default transcription model (can also be changed on the Settings page)
GEMINI_MODEL="gemini-3.8-flash"

# YouTube Settings
YT_RETRY_COUNT=3
# Max videos discovered per channel scan
YT_DISCOVERY_LIMIT=1

# MySQL container (docker-compose.yml); both are required
MYSQL_ROOT_PASSWORD=""
MYSQL_PASSWORD=""

# Slack Notifications
SLACK_WEBHOOK_URL=""
